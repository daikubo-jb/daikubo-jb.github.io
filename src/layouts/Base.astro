---
import '../styles/site.css';
import { localPath } from '../utils/paths';
import { siteName, githubProfile } from '../utils/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={localPath('icon.svg')} type="image/svg+xml" />
    <title>{title === siteName ? siteName : title + ' | ' + siteName}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {title !== siteName && <header class="site-header shell">
      <nav aria-label="Main navigation">
        <a href={localPath()}>Home</a>
        <a href={githubProfile}>GitHub</a>
      </nav>
    </header>}
    <main id="main" class="shell"><slot /></main>
  </body>
</html>
